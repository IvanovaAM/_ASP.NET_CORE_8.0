@model Cart
@{
	ViewData["Title"] = "Ваша корзина >> Оформление";
}

<div class="row justify-content-evenly">

	@if (Model != null && Model.Items?.Count > 0)
	{
		<div class="col-9">
			<table class="table table-responsive table-striped table-hover countLines mb-5">
				<thead>
					<tr align="center">
						<th scope="col">#</th>
						<th scope="col">Наименование товара</th>
						<th scope="col">Цена, руб.</th>
						<th scope="col">Количество, шт.</th>
						<th scope="col">Стоимость, руб.</th>
					</tr>
				</thead>
				<tbody>
					@foreach (var item in Model.Items)
					{
						<tr align="center">
							<td class="w3"></td>
							<td align="left">@item.Product?.Name</td>
							<td align="left">@item.Product?.Price</td>
							<td>@item.Quantity</td>
							<td>@item.Price</td>
						</tr>
					}
				</tbody>
				<tfoot>
					<tr align="center">
						<th colspan="2"></th>
						<th colspan="3">Общая стоимость: @Model.TotalPrice</th>
					</tr>
				</tfoot>
			</table>
		</div>
		@await Html.PartialAsync("OrderBlock", Model)
	}
	else
	{
		<div class="col">
			<h2 class="row-title">В корзине нет товаров!</h2>
		</div>

	}
</div>

@await Html.PartialAsync("ButtonToHome")

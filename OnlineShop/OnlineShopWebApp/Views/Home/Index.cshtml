@model HomeViewModel
@{
	ViewData["Title"] = "Главная";
}

<div class="row justify-content-center">
	@if (Model != null)
	{
		@if (!Model.IsFilter)
		{
			<h2 class="row-title mb-1">Рекомендуемые товары</h2>
		}
		else
		{
			<h2 class="row-title mb-1">Товары "@Model.CurrentFilter"</h2>
		}
		<h6 class="mt-0 mb-5 text-muted text-center">Количество товаров, шт.: @Model.ProductsViewModels.Count</h6>


		@foreach (var product in Model.ProductsViewModels)
		{
			@await Html.PartialAsync("ProductCard", product)
		}
	}
	else
	{
		<h2 class="row-title">Нет товаров для отображения!</h2>
	}
</div>






